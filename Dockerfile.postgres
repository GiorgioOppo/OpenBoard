# syntax=docker/dockerfile:1
FROM golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af AS gosu-build
COPY scripts/build-gosu.sh /usr/local/bin/build-gosu.sh
RUN sh /usr/local/bin/build-gosu.sh

# Keep the PostgreSQL 17 data format, entrypoint and backup tools unchanged.
FROM postgres:17.11-trixie@sha256:b8faeff7712663c2773a190181e1246e37e364b887611c04658c28b44e2408fe AS patched
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gosu-build /out/gosu /usr/local/bin/gosu
RUN gosu --version && gosu postgres true && postgres --version

# Publish the complete patched filesystem, without redistributing superseded
# vulnerable binaries in lower image layers. This retains every runtime file;
# restore the official image's metadata explicitly and regression test it.
FROM scratch
COPY --from=patched / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/17/bin \
    GOSU_VERSION=1.19 LANG=en_US.utf8 PG_MAJOR=17 \
    PG_VERSION=17.11-1.pgdg13+2 PGDATA=/var/lib/postgresql/data
LABEL org.opencontainers.image.title="OpenBoard PostgreSQL 17" \
    org.opencontainers.image.base.name="postgres:17.11-trixie" \
    org.opencontainers.image.base.digest="sha256:b8faeff7712663c2773a190181e1246e37e364b887611c04658c28b44e2408fe"
VOLUME /var/lib/postgresql/data
STOPSIGNAL SIGINT
EXPOSE 5432
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
