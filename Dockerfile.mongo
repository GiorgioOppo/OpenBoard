# syntax=docker/dockerfile:1
FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS gosu-build
COPY scripts/build-gosu.sh /usr/local/bin/build-gosu.sh
RUN sh /usr/local/bin/build-gosu.sh

FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS tools-build
ENV GOTOOLCHAIN=local
RUN apt-get update \
    && apt-get install -y --no-install-recommends libkrb5-dev \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/build-mongo-tools.sh /usr/local/bin/build-mongo-tools.sh
RUN sh /usr/local/bin/build-mongo-tools.sh

# Preserve the 8.0 server format, initialization and administration binaries.
FROM mongo:8.0.34-noble@sha256:0dc2511c4261bffa84f5af2c7df2aae148c0bea68d9b0aacd85c3d7be07e0583 AS patched
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gosu-build /out/gosu /usr/local/bin/gosu
COPY --from=tools-build /out/bin/ /usr/bin/
COPY --from=tools-build /out/js-yaml/ /opt/js-yaml/
ENV JSYAML_VERSION=3.15.2 JSYAML_CHECKSUM=7f005cf0b8ee639b4557e0e321dc067c1f2aa0a442d096e03f2ab53353738794
RUN gosu --version && gosu mongodb true \
    && mongod --version && mongodump --version && mongorestore --version

# Retain the entire patched distribution, excluding only obsolete bytes from
# previous layers. No tools or package records are removed to alter scan output.
FROM scratch
COPY --from=patched / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    GOSU_VERSION=1.19 JSYAML_VERSION=3.15.2 \
    JSYAML_CHECKSUM=7f005cf0b8ee639b4557e0e321dc067c1f2aa0a442d096e03f2ab53353738794 \
    MONGO_PACKAGE=mongodb-org MONGO_REPO=repo.mongodb.org MONGO_MAJOR=8.0 \
    MONGO_VERSION=8.0.34 HOME=/data/db GLIBC_TUNABLES=glibc.pthread.rseq=0
LABEL org.opencontainers.image.title="OpenBoard MongoDB 8.0" \
    org.opencontainers.image.base.name="mongo:8.0.34-noble" \
    org.opencontainers.image.base.digest="sha256:0dc2511c4261bffa84f5af2c7df2aae148c0bea68d9b0aacd85c3d7be07e0583"
VOLUME /data/db /data/configdb
EXPOSE 27017
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["mongod"]
