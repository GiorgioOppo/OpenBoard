POSTGRES_APP_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

OPENBOARD_PUBLIC_URL=http://openboard.localhost
OPENBOARD_PUBLISH_IP=127.0.0.1
OPENBOARD_HTTP_PORT=80
OPENBOARD_HTTPS_PORT=443
OPENBOARD_NPM_ADMIN_PORT=81
TZ=Europe/Rome
