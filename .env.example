# Run python3 scripts/init-env.py to generate .env with private random passwords.
# These empty passwords intentionally prevent a deployment with shared defaults.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

OPENBOARD_PUBLIC_URL=http://openboard.localhost
OPENBOARD_PUBLISH_IP=127.0.0.1
OPENBOARD_HTTP_PORT=80
OPENBOARD_HTTPS_PORT=443
OPENBOARD_NPM_ADMIN_PORT=81
OPENBOARD_FRONTEND_SUBNET=172.30.240.0/24
OPENBOARD_FRONTEND_IP_RANGE=172.30.240.128/25
OPENBOARD_PROXY_IP=172.30.240.2
# Optional limits: zero preserves unlimited quota / disabled cache guard.
OPENBOARD_ATTACHMENT_LIMIT_BYTES=0
OPENBOARD_ATTACHMENT_LIMIT_FILES=0
OPENBOARD_CACHE_TMPFS_SIZE=256m
OPENBOARD_CACHE_MAX_BYTES=0
OPENBOARD_CACHE_MIN_FREE_BYTES=0
TZ=Europe/Rome
