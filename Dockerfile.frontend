# Official unprivileged NGINX image; frontend contains public static assets only.
# https://github.com/nginx/docker-nginx-unprivileged
FROM nginxinc/nginx-unprivileged:1.30.6-alpine-slim@sha256:4ac59c85c8c46d9e91eaabd2122cda4923ba380cf11f4138e389f069bcdc77a3

# Apply distribution security fixes that may postdate the upstream image.
USER root
RUN apk upgrade --no-cache

COPY deploy/frontend.conf /etc/nginx/nginx.conf
COPY web/ /usr/share/nginx/html/

USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
STOPSIGNAL SIGQUIT
# Skip image initialization scripts: the root filesystem is read-only.
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
